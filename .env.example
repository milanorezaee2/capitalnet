# متغیرهای محیط برای پروژه
# کپی این فایل به .env و مقادیر واقعی را از Supabase Dashboard پر کنید

# ── Supabase ──────────────────────────────────────────────────────────────────
# از Supabase Dashboard → Settings → API بگیرید
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── راهنما ───────────────────────────────────────────────────────────────────
# 1. به https://supabase.com بروید و یک پروژه جدید بسازید
# 2. از Settings → API مقادیر URL و anon key را کپی کنید
# 3. این فایل را به .env کپی کنید و مقادیر را جایگزین کنید
